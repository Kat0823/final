<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Siknayan | Learner Accounts
    </title>

    <link
        rel="stylesheet"
        href="../css/style.css"
    >

    <script
        src="https://unpkg.com/lucide@latest"
    ></script>

</head>


<body>


    <!-- =====================================================
         TOP HEADER
    ====================================================== -->

    <header class="topbar">

        <div class="brand">

            <img
                src="../assets/images/mpsu_logo.png"
                alt="MPSU Logo"
                class="brand-logo"
            >

            <div class="brand-text">

                <h1>
                    MPSU ETEEAP LMS
                </h1>

                <p>
                    Mountain Province State University
                </p>

            </div>

        </div>


        <div class="topbar-right">

            <button
                class="icon-button notification-button"
                type="button"
                aria-label="Notifications"
            >

                <i data-lucide="bell"></i>

                <span class="notification-dot"></span>

            </button>


            <div class="profile">

                <img
                    src="../assets/images/macross.jpg"
                    alt="Macross Arsel"
                    class="profile-avatar"
                >

                <div class="profile-info">

                    <strong>
                        Macross Arsel
                    </strong>

                    <span>
                        Administrator
                    </span>

                </div>

                <i
                    data-lucide="chevron-down"
                    class="profile-chevron"
                ></i>

            </div>

        </div>

    </header>



    <!-- =====================================================
         APPLICATION LAYOUT
    ====================================================== -->

    <div class="app-layout">


        <!-- =================================================
             SIDEBAR
        ================================================== -->

        <aside
            class="sidebar"
            id="sidebar"
        >

            <div class="sidebar-top">

                <span class="sidebar-view-text">
                    View
                </span>


                <button
                    class="sidebar-toggle"
                    id="sidebarToggle"
                    type="button"
                    aria-label="Toggle sidebar"
                >

                    <i data-lucide="panel-left"></i>

                </button>

            </div>


            <div class="sidebar-profile">

                <img
                    src="../assets/images/macross.jpg"
                    alt="Macross Arsel"
                    class="sidebar-avatar"
                >

                <span class="sidebar-profile-name">
                    Macross
                </span>

            </div>


            <nav class="sidebar-nav">


                <!-- Dashboard -->

                <a
                    href="../index.html"
                    class="nav-item"
                >

                    <i
                        data-lucide="layout-dashboard"
                    ></i>

                    <span class="nav-label">
                        Dashboard
                    </span>

                </a>


                <!-- Learners -->

                <a
                    href="learners.html"
                    class="nav-item"
                >

                    <i data-lucide="users"></i>

                    <span class="nav-label">
                        Learners
                    </span>

                </a>


                <!-- Classes -->

                <a
                    href="classes.html"
                    class="nav-item"
                >

                    <i data-lucide="book-open"></i>

                    <span class="nav-label">
                        Classes
                    </span>

                </a>


                <!-- Module Library -->

                <a
                    href="module-library.html"
                    class="nav-item"
                >

                    <i data-lucide="folder"></i>

                    <span class="nav-label">
                        Module Library
                    </span>

                </a>


                <!-- Accounts -->

                <a
                    href="accounts.html"
                    class="nav-item active"
                >

                    <i
                        data-lucide="circle-user-round"
                    ></i>

                    <span class="nav-label">
                        Accounts
                    </span>

                </a>


                <!-- Reports -->

                <a
                    href="#"
                    class="nav-item"
                >

                    <i data-lucide="pie-chart"></i>

                    <span class="nav-label">
                        Reports
                    </span>

                </a>


                <!-- Notifications -->

                <a
                    href="#"
                    class="nav-item"
                >

                    <i data-lucide="bell"></i>

                    <span class="nav-label">
                        Notifications
                    </span>

                </a>

            </nav>


            <div class="sidebar-bottom">

                <a
                    href="#"
                    class="nav-item logout"
                >

                    <i data-lucide="log-out"></i>

                    <span class="nav-label">
                        Logout
                    </span>

                </a>

            </div>

        </aside>



        <!-- =================================================
             MAIN CONTENT
        ================================================== -->

        <main
            class="main-content learner-accounts-page"
        >


            <!-- Back -->

            <a
                href="accounts.html"
                class="back-link"
            >

                <i data-lucide="arrow-left"></i>

                Back to Accounts

            </a>



            <!-- =================================================
                 PAGE HEADING
            ================================================== -->

            <section class="learner-accounts-heading">

                <div>

                    <h2>
                        Learner Accounts
                    </h2>

                    <p>
                        Manage learner accounts, access, and enrollment information.
                    </p>

                </div>


                <button
                    type="button"
                    id="addLearnerAccountBtn"
                    class="primary-action-button"
                >

                    <i data-lucide="plus"></i>

                    Add Learner Account

                </button>

                <button
                    type="button"
                    id="importLearnersExcelBtn"
                    class="primary-action-button"
                >
                    <i data-lucide="file-spreadsheet"></i>
                    Import Learners from Excel
                </button>

                <input
                    type="file"
                    id="learnersExcelFile"
                    accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                    hidden
                >

                <button
                    type="button"
                    id="downloadLearnerCredentialsBtn"
                    class="primary-action-button"
                    hidden
                >
                    <i data-lucide="download"></i>
                    Download Credentials
                </button>

            </section>

            <div
                id="learnerExcelImportStatus"
                role="status"
                aria-live="polite"
                style="margin: 12px 0; white-space: pre-wrap;"
            ></div>

            <!-- =================================================
                 CONTROLS
            ================================================== -->

            <section class="learner-accounts-controls">


                <div class="accounts-search">

                    <i data-lucide="search"></i>

                    <input
                        type="text"
                        id="learnerAccountSearch"
                        placeholder="Search by student ID, name, email, or program..."
                        autocomplete="off"
                    >

                </div>


                <div class="accounts-filter-group">

                    <select
                        id="learnerAccountStatusFilter"
                    >

                        <option value="all">
                            All Status
                        </option>

                        <option value="active">
                            Active
                        </option>

                        <option value="inactive">
                            Inactive
                        </option>

                        <option value="not-set-up">
                            Not Set Up
                        </option>

                    </select>

                </div>

            </section>



            <!-- =================================================
                 TABLE
            ================================================== -->

            <section class="learner-accounts-table-card">

                <div class="table-wrapper">

                    <table class="learner-accounts-table">

                        <thead>

                            <tr>

                                <th>
                                    Student ID
                                </th>

                                <th>
                                    Learner
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Program
                                </th>

                                <th>
                                    Last Login
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody
                            id="learnerAccountsTableBody"
                        ></tbody>

                    </table>


                    <!-- EMPTY STATE -->

                    <div
                        id="learnerAccountsEmpty"
                        class="learner-accounts-empty"
                        hidden
                    >

                        <div class="empty-icon">

                            <i data-lucide="circle-user-round"></i>

                        </div>

                        <h3>
                            No Learners Found
                        </h3>

                        <p>
                            No learners match the current search or filter.
                        </p>

                    </div>

                </div>

            </section>

        </main>

    </div>



    <!-- =====================================================
         ADD / EDIT ACCOUNT MODAL
    ====================================================== -->

    <div
        id="learnerAccountModal"
        class="account-modal-overlay"
        hidden
    >

        <div class="account-modal">


            <div class="account-modal-header">

                <div>

                    <h3 id="learnerAccountModalTitle">
                        Create Learner Account
                    </h3>

                    <p
                        id="learnerAccountModalDescription"
                    >
                        Create a new learner and account.
                    </p>

                </div>


                <button
                    type="button"
                    class="account-modal-close"
                    id="closeLearnerAccountModal"
                    aria-label="Close"
                >

                    <i data-lucide="x"></i>

                </button>

            </div>



            <form
                id="learnerAccountForm"
            >

                <input
                    type="hidden"
                    id="accountEditId"
                >


                <!-- Student ID -->

                <div class="account-form-group">

                    <label for="accountStudentId">
                        Student ID
                    </label>

                    <input
                        type="text"
                        id="accountStudentId"
                        name="studentId"
                        placeholder="e.g. 23-00612"
                        autocomplete="off"
                        required
                    >

                </div>


                <!-- Full Name -->

                <div class="account-form-group">

                    <label for="accountFullName">
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="accountFullName"
                        name="fullName"
                        placeholder="Enter learner's full name"
                        autocomplete="off"
                        required
                    >

                </div>


                <!-- Program -->

                <div class="account-form-group">

                    <label for="accountProgram">
                        Program
                    </label>

                    <select
                        id="accountProgram"
                        name="program"
                        required
                    >

                        <option value="">
                            Select program
                        </option>

                    </select>

                </div>


                <!-- Email -->

                <div class="account-form-group">

                    <label for="accountEmail">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="accountEmail"
                        name="email"
                        placeholder="learner@example.com"
                        autocomplete="email"
                        required
                    >

                </div>


                <!-- Password -->

                <div class="account-form-group">

                    <label for="accountPassword">
                        Temporary Password
                    </label>


                    <div class="password-input-row">

                        <input
                            type="text"
                            id="accountPassword"
                            name="password"
                            autocomplete="new-password"
                            required
                        >


                        <button
                            type="button"
                            id="generatePasswordBtn"
                            class="secondary-action-button"
                        >

                            Regenerate

                        </button>

                    </div>


                    <small>
                        Prototype only. Password storage
                        will be replaced by backend
                        authentication later.
                    </small>

                </div>


                <!-- Status -->

                <div
                    class="account-form-group"
                    id="accountStatusGroup"
                >

                    <label for="accountStatus">
                        Account Status
                    </label>

                    <select
                        id="accountStatus"
                        name="status"
                    >

                        <option value="active">
                            Active
                        </option>

                        <option value="inactive">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- Actions -->

                <div class="account-modal-actions">

                    <button
                        type="button"
                        id="cancelLearnerAccount"
                        class="secondary-action-button"
                    >

                        Cancel

                    </button>


                    <button
                        type="submit"
                        class="primary-action-button"
                        id="saveLearnerAccountBtn"
                    >

                        Create Account

                    </button>

                </div>

            </form>

        </div>

    </div>



    <!-- =====================================================
         RESET PASSWORD MODAL
    ====================================================== -->

    <div
        id="resetPasswordModal"
        class="account-modal-overlay"
        hidden
    >

        <div
            class="account-modal account-small-modal"
        >

            <div class="account-modal-header">

                <div>

                    <h3>
                        Reset Password
                    </h3>

                    <p
                        id="resetPasswordDescription"
                    >
                        Generate a new temporary password.
                    </p>

                </div>


                <button
                    type="button"
                    class="account-modal-close"
                    id="closeResetPasswordModal"
                    aria-label="Close"
                >

                    <i data-lucide="x"></i>

                </button>

            </div>


            <div class="reset-password-content">

                <label for="resetPasswordValue">
                    Temporary Password
                </label>


                <div class="password-input-row">

                    <input
                        type="text"
                        id="resetPasswordValue"
                        readonly
                    >


                    <button
                        type="button"
                        id="regenerateResetPassword"
                        class="secondary-action-button"
                    >

                        Regenerate

                    </button>

                </div>

            </div>


            <div class="account-modal-actions">

                <button
                    type="button"
                    id="cancelResetPassword"
                    class="secondary-action-button"
                >

                    Cancel

                </button>


                <button
                    type="button"
                    id="confirmResetPassword"
                    class="primary-action-button"
                >

                    Reset Password

                </button>

            </div>

        </div>

    </div>



    <!-- =====================================================
         DELETE LEARNER MODAL
    ====================================================== -->

    <div
        id="deleteAccountModal"
        class="account-modal-overlay"
        hidden
    >

        <div
            class="account-modal account-small-modal"
        >

            <div class="account-modal-header">

                <div>

                    <h3>
                        Delete Learner
                    </h3>

                    <p>
                        This permanently deletes the learner and
                        their account, if one exists. Assigned
                        class memberships will be removed.
                    </p>

                </div>


                <button
                    type="button"
                    class="account-modal-close"
                    id="closeDeleteAccountModal"
                    aria-label="Close"
                >

                    <i data-lucide="x"></i>

                </button>

            </div>


            <div class="delete-account-content">

                <p
                    id="deleteAccountMessage"
                >
                    Delete this learner?
                </p>


                <label class="delete-confirmation">

                    <input
                        type="checkbox"
                        id="confirmDeleteAccount"
                    >

                    <span>
                        I understand that the learner and their
                        account will be permanently deleted, and
                        assigned class memberships will be removed.
                    </span>

                </label>

            </div>


            <div class="account-modal-actions">

                <button
                    type="button"
                    id="cancelDeleteAccount"
                    class="secondary-action-button"
                >

                    Cancel

                </button>


                <button
                    type="button"
                    id="confirmDeleteAccountBtn"
                    class="danger-action-button"
                    disabled
                >

                    <i data-lucide="trash-2"></i>

                    <span>
                        Delete Learner
                    </span>

                </button>

            </div>

        </div>

    </div>



    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script src="../js/shared.js"></script>

    <script src="../js/program-data.js"></script>

    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="../js/learners.js"></script>

    <script src="../js/accounts-learners.js"></script>

</body>

</html>