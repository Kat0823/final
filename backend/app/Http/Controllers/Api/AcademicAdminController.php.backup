<?php

namespace App\Http\Controllers\Api;

use Illuminate\Support\Facades\Hash;
use Illuminate\Validation\Rule;

use App\Models\Module;
use App\Http\Controllers\Controller;
use App\Models\Course;
use App\Models\User;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;

class AcademicAdminController extends Controller
{
    /**
     * Check if the authenticated user is an Academic Administrator.
     */
    private function checkAdmin(Request $request): ?JsonResponse
    {
        $user = $request->user();

        if (!$user || $user->role !== 'academic_admin') {
            return response()->json([
                'success' => false,
                'message' => 'Only Academic Administrators can access this resource.',
            ], 403);
        }

        return null;
    }

    /**
     * Academic Admin Dashboard
     */
    public function dashboard(Request $request): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        return response()->json([
            'success' => true,
            'statistics' => [
                'learners' => User::where('role', 'learner')->count(),
                'instructors' => User::where('role', 'instructor')->count(),
                'classes' => Course::count(),
                'active_classes' => Course::where('is_active', true)->count(),
            ],
        ]);
    }

    /**
     * Get all learners.
     */
    public function learners(Request $request): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $learners = User::where('role', 'learner')
            ->latest()
            ->get([
                'id',
                'name',
                'email',
                'school_id',
                'program',
                'contact',
                'password_setup_complete',
                'created_at',
            ]);

        return response()->json([
            'success' => true,
            'learners' => $learners,
        ]);
    }

    /**
     * Create a learner.
     */
    public function storeLearner(Request $request): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $validated = $request->validate([
            'name' => ['required', 'string', 'max:255'],
            'email' => ['required', 'email', 'max:255', 'unique:users,email'],
            'school_id' => ['required', 'string', 'max:100', 'unique:users,school_id'],
            'program' => ['nullable', 'string', 'max:255'],
            'contact' => ['nullable', 'string', 'max:50'],
            'password' => ['required', 'string', 'min:8'],
        ]);

        $learner = User::create([
            'name' => $validated['name'],
            'email' => $validated['email'],
            'school_id' => $validated['school_id'],
            'program' => $validated['program'] ?? null,
            'contact' => $validated['contact'] ?? null,
            'password' => Hash::make($validated['password']),
            'role' => 'learner',
            'password_setup_complete' => true,
        ]);

        return response()->json([
            'success' => true,
            'message' => 'Learner created successfully.',
            'learner' => $learner->only([
                'id',
                'name',
                'email',
                'school_id',
                'program',
                'contact',
                'password_setup_complete',
                'created_at',
            ]),
        ], 201);
    }

    /**
     * Update a learner.
     */
    public function updateLearner(Request $request, int $id): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $learner = User::where('role', 'learner')->find($id);

        if (!$learner) {
            return response()->json([
                'success' => false,
                'message' => 'Learner not found.',
            ], 404);
        }

        $validated = $request->validate([
            'name' => ['sometimes', 'required', 'string', 'max:255'],

            'email' => [
                'sometimes',
                'required',
                'email',
                'max:255',
                Rule::unique('users', 'email')->ignore($learner->id),
            ],

            'school_id' => [
                'sometimes',
                'required',
                'string',
                'max:100',
                Rule::unique('users', 'school_id')->ignore($learner->id),
            ],

            'program' => ['nullable', 'string', 'max:255'],
            'contact' => ['nullable', 'string', 'max:50'],
            'password' => ['nullable', 'string', 'min:8'],
        ]);

        if (array_key_exists('password', $validated) && $validated['password']) {
            $validated['password'] = Hash::make($validated['password']);
        } else {
            unset($validated['password']);
        }

        $learner->update($validated);

        return response()->json([
            'success' => true,
            'message' => 'Learner updated successfully.',
            'learner' => $learner->fresh()->only([
                'id',
                'name',
                'email',
                'school_id',
                'program',
                'contact',
                'password_setup_complete',
                'created_at',
                'updated_at',
            ]),
        ]);
    }

    /**
     * Delete a learner.
     */
    public function destroyLearner(Request $request, int $id): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $learner = User::where('role', 'learner')->find($id);

        if (!$learner) {
            return response()->json([
                'success' => false,
                'message' => 'Learner not found.',
            ], 404);
        }

        $learner->delete();

        return response()->json([
            'success' => true,
            'message' => 'Learner deleted successfully.',
        ]);
    }

    /**
     * Get all instructors.
     */
    public function instructors(Request $request): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $instructors = User::where('role', 'instructor')
            ->latest()
            ->get([
                'id',
                'name',
                'email',
                'school_id',
                'program',
                'contact',
                'password_setup_complete',
                'created_at',
            ]);

        return response()->json([
            'success' => true,
            'instructors' => $instructors,
        ]);
    }

    /**
     * Create an instructor.
     */
    public function storeInstructor(Request $request): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $validated = $request->validate([
            'name' => ['required', 'string', 'max:255'],
            'email' => ['required', 'email', 'max:255', 'unique:users,email'],
            'school_id' => ['required', 'string', 'max:255', 'unique:users,school_id'],
            'program' => ['nullable', 'string', 'max:255'],
            'contact' => ['nullable', 'string', 'max:255'],
            'password' => ['required', 'string', 'min:8'],
        ]);

        $instructor = User::create([
            'name' => $validated['name'],
            'email' => $validated['email'],
            'school_id' => $validated['school_id'],
            'program' => $validated['program'] ?? null,
            'contact' => $validated['contact'] ?? null,
            'password' => Hash::make($validated['password']),
            'role' => 'instructor',
            'password_setup_complete' => true,
        ]);

        return response()->json([
            'success' => true,
            'message' => 'Instructor created successfully.',
            'instructor' => $instructor->only([
                'id',
                'name',
                'email',
                'school_id',
                'program',
                'contact',
                'password_setup_complete',
                'created_at',
            ]),
        ], 201);
    }

    /**
     * Update an instructor.
     */
    public function updateInstructor(Request $request, int $id): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $instructor = User::where('role', 'instructor')->find($id);

        if (!$instructor) {
            return response()->json([
                'success' => false,
                'message' => 'Instructor not found.',
            ], 404);
        }

        $validated = $request->validate([
            'name' => ['sometimes', 'required', 'string', 'max:255'],

            'email' => [
                'sometimes',
                'required',
                'email',
                'max:255',
                Rule::unique('users', 'email')->ignore($instructor->id),
            ],

            'school_id' => [
                'sometimes',
                'required',
                'string',
                'max:255',
                Rule::unique('users', 'school_id')->ignore($instructor->id),
            ],

            'program' => ['nullable', 'string', 'max:255'],
            'contact' => ['nullable', 'string', 'max:255'],
            'password' => ['nullable', 'string', 'min:8'],
        ]);

        $updateData = [
            'name' => $validated['name'] ?? $instructor->name,
            'email' => $validated['email'] ?? $instructor->email,
            'school_id' => $validated['school_id'] ?? $instructor->school_id,
            'program' => array_key_exists('program', $validated)
                ? $validated['program']
                : $instructor->program,
            'contact' => array_key_exists('contact', $validated)
                ? $validated['contact']
                : $instructor->contact,
        ];

        if (!empty($validated['password'])) {
            $updateData['password'] = Hash::make($validated['password']);
        }

        $instructor->update($updateData);

        return response()->json([
            'success' => true,
            'message' => 'Instructor updated successfully.',
            'instructor' => $instructor->fresh()->only([
                'id',
                'name',
                'email',
                'school_id',
                'program',
                'contact',
                'password_setup_complete',
                'created_at',
                'updated_at',
            ]),
        ]);
    }

    /**
     * Delete an instructor.
     */
    public function destroyInstructor(Request $request, int $id): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $instructor = User::where('role', 'instructor')->find($id);

        if (!$instructor) {
            return response()->json([
                'success' => false,
                'message' => 'Instructor not found.',
            ], 404);
        }

        $instructor->delete();

        return response()->json([
            'success' => true,
            'message' => 'Instructor deleted successfully.',
        ]);
    }

    /**
     * Get all classes.
     */
    public function classes(Request $request): JsonResponse
    {
        if ($response = $this->checkAdmin($request)) {
            return $response;
        }

        $classes = Course::with([
            'instructor:id,name,school_id',
            'learners:id,name,school_id',
        ])
            ->withCount([
                'learners',
                'modules',
            ])
            ->latest()
            ->get();

        return response()->json([
            'success' => true,
            'classes' => $classes,
        ]);
        
    }
    /**
 * Create a class.
 */
public function storeClass(Request $request): JsonResponse
{
    if ($response = $this->checkAdmin($request)) {
        return $response;
    }

    $validated = $request->validate([
        'name' => ['required', 'string', 'max:255'],
        'code' => ['required', 'string', 'max:100', 'unique:courses,code'],
        'program' => ['nullable', 'string', 'max:255'],
        'description' => ['nullable', 'string'],
        'instructor_id' => [
            'nullable',
            'integer',
            Rule::exists('users', 'id')->where(function ($query) {
                $query->where('role', 'instructor');
            }),
        ],
        'is_active' => ['sometimes', 'boolean'],
    ]);

    $class = Course::create([
        'name' => $validated['name'],
        'code' => $validated['code'],
        'program' => $validated['program'] ?? null,
        'description' => $validated['description'] ?? null,
        'instructor_id' => $validated['instructor_id'] ?? null,
        'is_active' => $validated['is_active'] ?? true,
    ]);

    $class->load([
        'instructor:id,name,school_id',
    ]);

    return response()->json([
        'success' => true,
        'message' => 'Class created successfully.',
        'class' => $class,
    ], 201);
}

/**
 * Update a class.
 */
public function updateClass(Request $request, int $id): JsonResponse
{
    if ($response = $this->checkAdmin($request)) {
        return $response;
    }

    $class = Course::find($id);

    if (!$class) {
        return response()->json([
            'success' => false,
            'message' => 'Class not found.',
        ], 404);
    }

    $validated = $request->validate([
        'name' => ['sometimes', 'required', 'string', 'max:255'],

        'code' => [
            'sometimes',
            'required',
            'string',
            'max:100',
            Rule::unique('courses', 'code')->ignore($class->id),
        ],

        'program' => ['nullable', 'string', 'max:255'],
        'description' => ['nullable', 'string'],

        'instructor_id' => [
            'nullable',
            'integer',
            Rule::exists('users', 'id')->where(function ($query) {
                $query->where('role', 'instructor');
            }),
        ],

        'is_active' => ['sometimes', 'boolean'],
    ]);

    $class->update($validated);

    $class->load([
        'instructor:id,name,school_id',
    ]);

    return response()->json([
        'success' => true,
        'message' => 'Class updated successfully.',
        'class' => $class,
    ]);
}

