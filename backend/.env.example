APP_NAME=Siknayan
APP_ENV=production
APP_KEY=
# Keep false anywhere other people can reach the server: debug pages
# show source code and settings. Set true only on your own computer.
APP_DEBUG=false
APP_URL=http://localhost:8000
# The website's address (where index.html is served); used for links in emails.
FRONTEND_URL=http://127.0.0.1:5501

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, as in the proposal. Create the database first (for example in phpMyAdmin
# or MySQL Workbench): CREATE DATABASE siknayan CHARACTER SET utf8mb4;
# With docker compose these values are supplied by docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siknayan
DB_USERNAME=root
DB_PASSWORD=

# For a quick run without MySQL, replace the five DB_ lines above with:
# DB_CONNECTION=sqlite
# (then run: touch database/database.sqlite). PHPUnit always uses in-memory SQLite.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" only writes emails to storage/logs/laravel.log. To really send them
# (e.g. forgot-password codes) use smtp, for example Gmail with an App Password:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=your.address@gmail.com  MAIL_PASSWORD=<16-character app password>
#   MAIL_FROM_ADDRESS=your.address@gmail.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Minutes before a login expires (480 = 8 hours).
SANCTUM_TOKEN_EXPIRATION=480

# Used only by `php artisan db:seed` to create the first Academic Admin
# (ADMIN-001). Leave empty to have a random password generated and shown.
SIKNAYAN_SEED_ADMIN_PASSWORD=

# Reverse proxies whose X-Forwarded-For header may be trusted (comma-separated
# IPs or ranges). Empty = trust none (correct when users reach Laravel directly).
# Behind Docker/nginx, e.g.: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=
